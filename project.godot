config_version=5

[accessibility]

general/accessibility_support=2
general/accessibility_driver="dummy"

[application]

config/name="saim"
config/version="0.1"
run/main_scene="uid://bjba2v1kmuux"
config/features=PackedStringArray("4.7", "Forward Plus")
run/delta_smoothing=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

Config="*uid://dyp58f0nu2h0q"
Fps="*uid://cug5f02uj0la6"
ConfigManager="*uid://qdwhlm28wp7e"
CloseListener="*uid://du4sountsjd6y"
PluginLoader="*uid://bwvlc3spe8mol"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/sharp_corners=true
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
display_server/driver.linuxbsd="x11"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="scratchpad"

